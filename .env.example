# Password for the `fuzzer` Postgres role. Read by docker-compose,
# db/run_migrations.py and triage/run_triage.sh. Generate a strong one, e.g.:
#   openssl rand -base64 24
FUZZER_DB_PASSWORD=

# Optional overrides read by triage/run_triage.sh (defaults shown):
#TARGET_ID=
#AFL_OUTPUT=/data/afl-output
#CASR_OUTPUT=/data/casr-reports
#LOG_FILE=/data/triage.log
#DB_CONTAINER=fuzzer-db
#FUZZER_IMAGE=fuzzer-pipeline-fuzzer0
#HARNESS=/fuzzing/harness
#POC_ARCHIVE_ROOT=/data/poc_archive
#AFL_MASTER_CONTAINER=fuzzer-master
